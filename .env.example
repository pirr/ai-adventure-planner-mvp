# Optional. If absent, Open-Meteo fallback is used.
OPENWEATHER_API_KEY=

# Defaults work without changes.
# Sent on every outbound API call. overpass-api.de blocks default library agents
# (python-httpx/*) with HTTP 406, so identify the app; add contact info for prod.
USER_AGENT=ai-adventure-planner-mvp/0.1
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional comma-separated fallback Overpass mirrors, tried when the primary is
# busy. Empty by default — only add mirrors your network can reach quickly, since
# an unreachable one costs a full timeout before falling back to sample places.
# The most reliable option is pointing OVERPASS_URL at a self-hosted instance.
OVERPASS_MIRRORS=
OVERPASS_TIMEOUT_SECONDS=12
OVERPASS_MAX_ATTEMPTS=2
OVERPASS_RETRY_BACKOFF_SECONDS=0.5
OSRM_URL=https://router.project-osrm.org
USE_OPEN_METEO_FALLBACK=true
HTTP_TIMEOUT_SECONDS=8
SQLITE_PATH=./data/adventures.db
# App log level (INFO by default). Set DEBUG for verbose LLM/HTTP logs.
LOG_LEVEL=INFO

# --- Security / abuse protection ---
# Cross-origin allow-list. Empty = same-origin only (the default; the frontend
# is served by this backend). Set a comma-separated list of full origins only
# if a separate frontend host must call the API, e.g.
#   ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=
# Per-client-IP HTTP rate limiting (slowapi). Set false to disable (tests do).
# Behind Fly the client IP is read from the Fly-Client-IP header.
RATE_LIMIT_ENABLED=true
# Loose global default per IP (covers static assets + the health check).
RATE_LIMIT_DEFAULT=120/minute
# Heaviest endpoint (external APIs + Google Places + LLM). ';' joins windows.
RATE_LIMIT_RECOMMENDATIONS=10/minute;100/day
# LLM free-text parse calls per IP.
RATE_LIMIT_PARSE=5/minute;30/day
# Account registration/login/OAuth entrypoints.
RATE_LIMIT_AUTH=5/minute;50/day
# When true, anonymous users can see the first recommendation batch but must
# create an account or sign in before loading additional rotated results.
REQUIRE_AUTH_FOR_MORE_RECOMMENDATIONS=false

# --- Authentication ---
# Local dev can keep AUTH_COOKIE_SECURE=false. Production behind HTTPS should
# set it true (fly.toml does this for the Fly deployment).
AUTH_SESSION_COOKIE_NAME=ap_session
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_PASSWORD_MIN_LENGTH=8

# Optional Google OAuth. Create a Web OAuth client and set the redirect URI to:
#   https://your-domain.example.com/api/auth/google/callback
# For local dev:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Google Places enrichment (0.3) ---
# Optional. When set, the top candidates get real Google ratings (blended into
# place quality) and photo backfill. Absent => pipeline is OSM-only, unchanged.
# Restrict the key in Cloud Console: Places API only + server IP; cap the API
# quota slightly above GOOGLE_PLACES_DAILY_LIMIT (see docs/MVP_0.3_SCOPE.md).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=5
# In-process cache TTL per place (seconds). Keep within Google's 30-day cap.
GOOGLE_PLACES_CACHE_TTL_SECONDS=86400
# Max places enriched per search request (cost cap).
GOOGLE_PLACES_MAX_ENRICHED=15
# App-side daily budgets: global and per anonymous user. 0 disables enrichment.
GOOGLE_PLACES_DAILY_LIMIT=800
GOOGLE_PLACES_USER_DAILY_LIMIT=60

# --- LLM explanation layer (0.2) ---
# Default "template" keeps the built-in rule-based explanations and makes no
# network call. Switch to an OpenAI-compatible provider for model-written,
# fact-grounded summaries (the grounding guard falls back to templates if a
# model invents data). Presets only set the base URL; model/key still apply:
#   llamacpp | ollama | openai | deepseek | groq | openrouter | gemini
# Google Gemini example (uses its OpenAI-compatible endpoint):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-2.5-flash       # a Gemini model id (e.g. gemini-flash-latest)
#   LLM_API_KEY=<your gemini api key>
LLM_PROVIDER=template
# Master switch — set false to force templates regardless of LLM_PROVIDER.
LLM_ENABLED=true
# Override the base URL (needed for LLM_PROVIDER=openai without a preset, or a
# custom host). e.g. http://localhost:8080/v1 (llama.cpp), https://api.openai.com/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Bearer token for hosted providers; leave empty for a local llama.cpp / Ollama server.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
# Only the top N recommendations are sent to the model, to bound latency/cost.
LLM_MAX_EXPLAINED=5
# A/B the LLM explanations vs templates: when true (and an LLM is configured),
# half of anonymous_ids see templates as control. Compare via GET /api/ab.
AB_TEST_ENABLED=false
# Optional comma-separated fallback model ids, tried in order if the primary
# errors (used by the OpenAI-compatible provider). e.g. gemini-2.0-flash,gemini-1.5-flash
LLM_FALLBACK_MODELS=
# Optional Gemini reasoning effort ("low" / "none"); leave empty to omit.
GEMINI_REASONING_EFFORT=

# --- Free-text "Describe your trip" parsing (0.4) ---
# Needs a real LLM_PROVIDER above; with "template" the field stays hidden.
LLM_PARSE_ENABLED=true
# App-side daily budgets for parse calls; 0 disables the feature.
LLM_PARSE_DAILY_LIMIT=500
LLM_PARSE_USER_DAILY_LIMIT=30
